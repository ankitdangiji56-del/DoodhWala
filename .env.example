# ==============================================================================
# Doodhwala Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# --- SUPABASE CONFIGURATION (Public Frontend) ---
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# --- STOREFRONT BUSINESS SETTINGS ---
VITE_STORE_NAME=Doodhwala
VITE_STORE_TAGLINE="Pure & Farm-Fresh Dairy Delivered Daily"
VITE_STORE_PHONE="+91 98765 43210"
VITE_STORE_EMAIL=care@doodhwala.local
VITE_WHATSAPP_SUPPORT_NUMBER=919876543210

# --- UPI / QR PAYMENT SETTINGS ---
# UPI ID to display on QR code and payment instructions
VITE_STORE_UPI_ID=doodhwala@upi
VITE_STORE_UPI_PAYEE_NAME="Doodhwala Fresh Dairy"

# ==============================================================================
# SERVER-SIDE ONLY SECRETS (Configure in Supabase Dashboard -> Edge Functions)
# Do NOT prefix these with VITE_ to keep them strictly off the frontend bundle!
# ==============================================================================
# WHATSAPP_CLOUD_API_TOKEN=your_meta_system_user_permanent_token
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
# WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id
# ADMIN_ALERT_PHONE_NUMBER=919876543210
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
